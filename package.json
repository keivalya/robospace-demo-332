{
  "name": "mujoco_wasm",
  "version": "0.0.2",
  "description": "Run MuJoCo simulations in browser",
  "main": "dist/mujoco_wasm.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "test": "node --import ./test/register.mjs test/compile-diagnostics.test.mjs",
    "test:inputs": "node --import ./test/register.mjs test/scene-writer-inputs.test.mjs",
    "test:bridge": "node --import ./test/register.mjs test/parent-bridge.test.mjs",
    "test:packs": "node --import ./test/register.mjs test/robot-packs.test.mjs",
    "test:scene": "node --import ./test/register.mjs tools/check-scene.mjs test/fixtures/kitchen_stretch.xml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zalo/mujoco_wasm.git"
  },
  "keywords": [
    "mujoco",
    "wasm"
  ],
  "author": "Sergei Surovtsev and Johnathon Selstad",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/zalo/mujoco_wasm/issues"
  },
  "homepage": "https://github.com/zalo/mujoco_wasm#readme",
  "dependencies": {
    "three": "^0.150.1"
  }
}
